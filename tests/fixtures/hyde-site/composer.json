{
    "name": "hydephp/reading-time-fixture",
    "description": "Hyde site used by reading-time integration tests",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false,
                "versions": {
                    "hydephp/hyde-reading-time": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "hyde/framework": "^2.0.3",
        "hydephp/hyde-reading-time": "0.1.x-dev",
        "laravel-zero/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"@unlink('./app/storage/framework/cache/packages.php');\"",
            "@php hyde package:discover --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "hyde"
    ]
}
