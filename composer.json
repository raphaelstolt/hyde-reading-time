{
    "name": "stolt/hyde-reading-time",
    "description": "Estimated Markdown reading times for HydePHP pages.",
    "type": "library",
    "keywords": [
        "hydephp",
        "hyde",
        "reading-time",
        "hydephp-extension"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "hyde/framework": "^2.0.3",
        "league/commonmark": "^2.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "HydeReadingTime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HydeReadingTime\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HydeReadingTime\\ReadingTimeServiceProvider"
            ]
        }
    },
    "scripts": {
        "fixture:install": "composer install --working-dir=tests/fixtures/hyde-site --no-interaction --prefer-dist --no-progress",
        "test": [
            "@fixture:install",
            "./vendor/bin/phpunit"
        ],
        "lint": "mago lint",
        "analyze": "mago analyze",
        "fmt": "mago fmt src tests/Unit tests/Integration config",
        "analyse": "phpstan analyse --no-progress",
        "format:check": "mago format --check src tests/Unit tests/Integration config",
        "check": [
            "@lint",
            "@analyze",
            "@analyse",
            "@format:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    }
}